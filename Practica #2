        private void button1_Click(object sender, EventArgs e)
        {
            // 1. Validar que la caja no esté vacía o tenga letras
            if (!decimal.TryParse(textventa.Text, out decimal valorventa))
            {
                MessageBox.Show("Por favor, ingrese un monto numérico válido.", 
                                "Entrada incorrecta", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                textventa.Focus();
                return;
            }

            // 2. Validar que la venta sea mayor a cero
            if (valorventa <= 0)
            {
                MessageBox.Show("El valor de la venta debe ser mayor a 0.", 
                                "Monto inválido", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                textventa.Focus();
                return;
            }

            decimal descuentoporcentaje;
            decimal descuentoventa;
            decimal valorfinal;

            if (valorventa >= 500)
            {
                descuentoporcentaje = 0.30m;
            }
            else if (valorventa >= 300 && valorventa <= 499)
            {
                descuentoporcentaje = 0.20m;
            }
            else if (valorventa >= 100 && valorventa <= 299)
            {
                descuentoporcentaje = 0.10m;
            }
            else descuentoporcentaje = 0;

            descuentoventa = valorventa * descuentoporcentaje;
            valorfinal = valorventa - descuentoventa;

            txtfinal.Text = valorfinal.ToString("N2");
            textdes.Text = descuentoventa.ToString("N2");   
            textdess.Text = (descuentoporcentaje * 100).ToString("0") + "%";
        }

        private void button2_Click(object sender, EventArgs e)
        {
            textventa.Text = "";
            textdes.Text = "";
            textdess.Text = "";
            txtfinal.Text = "";
            textventa.Focus();
        }

