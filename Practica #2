        private void button1_Click(object sender, EventArgs e)
        {
            decimal valorventa = Convert.ToInt32(textventa.Text);
            decimal descuentoporcentaje;
            decimal descuentoventa;
            decimal valorfinal;

            if (valorventa >= 500)
            {
                descuentoporcentaje = 0.30m;
            }
            else if (valorventa >= 300 && valorventa <= 499)
            {
                descuentoporcentaje = 0.20m;
            }
            else if (valorventa >= 100 && valorventa <= 299)
            {
                descuentoporcentaje = 0.10m;
            }
            else descuentoporcentaje = 0;

            descuentoventa = valorventa * descuentoporcentaje;
            valorfinal = valorventa - descuentoventa;

            txtfinal.Text = valorfinal.ToString();
            textdes.Text = descuentoventa.ToString();   
            textdess.Text = descuentoporcentaje.ToString();
        }

        private void button2_Click(object sender, EventArgs e)
